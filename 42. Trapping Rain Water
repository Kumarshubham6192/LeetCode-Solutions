class Solution {
    public int trap(int[] height) {
        int a[] = new int[20000];
        int b[] = new int[20000];
        int len = height.length;
        int max1= height[0] ;
        int max2 = height[len-1] ;
        int sum = 0;
        for(int i=0 ; i<len ; i++){
            max1 = Math.max(max1,height[i]);
            a[i]=max1;
            max2 = Math.max(max2,height[len-1-i]);
            b[len-i-1] = max2;
        }
        for(int j=0 ; j<len ; j++){
            sum +=(Math.min(a[j],b[j]) - height[j]);
        }
        return sum;
        
    }
}
