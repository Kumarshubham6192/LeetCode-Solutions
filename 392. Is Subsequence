class Solution:
    def isSubsequence(self, s: str, t: str) -> bool:
        tem = 0
        count = 0
        i=0
        while(tem<(len(s)) and i<len(t)):
            if t[i] == s[tem]:
                count += 1
                tem += 1
            i+=1

        if count == len(s):
            return True
        else:
            return False
