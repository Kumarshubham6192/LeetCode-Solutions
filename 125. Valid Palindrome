class Solution {
    public boolean isPalindrome(String s) {
        int len = s.length();
        StringBuilder ns = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c)) {
                ns.append(Character.toLowerCase(c));
            }
        }
        int n = ns.length();
        for(int j=0 ; j < n/2 ; j++) {
            if(ns.charAt(j) != ns.charAt(n-1-j)){
                return false;
            }
        } 
    return true;
    }
}
