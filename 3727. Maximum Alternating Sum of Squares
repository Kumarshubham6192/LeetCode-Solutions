class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:

        for j in range(len(nums)):
            if nums[j]<0:
                nums[j] = -(nums[j])
        nums.sort()
        score=0
        if(len(nums)%2==0):
            for i in range(len(nums)-1,-1,-1):
                if i>=(len(nums)/2):
                    score+=(nums[i]*nums[i])
                else:
                    score-=(nums[i]*nums[i])
        else:
            for i in range(len(nums)-1,-1,-1):
                if i>=(len(nums)//2):
                    score+=(nums[i]*nums[i])
                else:
                    score-=(nums[i]*nums[i])
        return score
        
