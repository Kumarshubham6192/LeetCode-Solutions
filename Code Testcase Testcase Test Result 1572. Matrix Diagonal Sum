class Solution {
    public int diagonalSum(int[][] mat) {
        int n = mat.length;
        int sum = 0 ;
        if(n%2==0){
            for(int i = 0 ; i<n ; i++){
                sum += mat[i][i];
                sum += mat[i][n-1-i];
        }
        return sum;
        
        }
        else{
            int mid = n-1-(n/2);
            for(int i = 0 ; i<n ; i++){
                sum += mat[i][i];
                sum += mat[i][n-1-i];
            }
        return sum - mat[mid][mid];
        }
        
    }
}
